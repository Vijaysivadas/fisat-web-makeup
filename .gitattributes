# Store text with LF line endings in the repo (and check it out as LF),
# regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

*.html  text diff=html
*.css   text diff=css
*.js    text
*.mjs   text
*.json  text
*.md    text diff=markdown
*.svg   text

# Binary assets — never touch line endings or try to diff them
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.mp4   binary

# Third-party code: exclude from GitHub language stats and diffs
assets/vendor/**              linguist-vendored -diff

# Generated by `npm run build` — collapsed in GitHub diffs
assets/js/search-index.js     linguist-generated -diff
_build/content/**             linguist-generated
_build/data/**                linguist-generated
index.html                    linguist-generated
about/**                      linguist-generated
